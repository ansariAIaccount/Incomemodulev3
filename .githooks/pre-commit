#!/bin/sh
#
# 1. Bump PCS_VERSION_MINOR on every commit that touches the builder.
# 2. Write build-manifest.json — the sha256 of every file that must be
#    deployed together.
#
# The manifest is the point. The app is SEVEN files, not one, and a deploy
# that copies some of them leaves the page looking current while behaving
# like an older build: the HTML carries the version label, so it says what
# you expect even when the engine beside it is weeks old. Two accounting
# fixes went missing exactly that way. pcsVersion() reads this manifest at
# runtime and names the files whose contents do not match.
#
# Install once per clone — hooks are not cloned with a repo:
#     git config core.hooksPath .githooks
#
# Skip for a single commit with:  git commit --no-verify
#
set -e

SRC="Incomemodulev3"
FILE="$SRC/loan-module-v4-builder.html"
MANIFEST="$SRC/build-manifest.json"
MARKER="PCS_AUTO_MINOR"

# Every file the browser loads from our own origin. Keep in step with the
# <script src> tags in the builder HTML — a file missing from this list is a
# file nobody will notice going stale.
DEPLOYABLES="loan-module-v4-builder.html
portf-excel-parser.js
loan-module-engine.js
loan-module-instruments.js
loan-module-analytics.js
demo-assistant-kb.js
demo-assistant-system-prompt.js"

sha_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -c1-16
  else openssl dgst -sha256 "$1" | sed -E 's/.*= *//' | cut -c1-16
  fi
}

# ── 1 · version bump (only when the builder is in this commit) ────────────
if git diff --cached --name-only | grep -qx "$FILE" && [ -f "$FILE" ]; then
  LINE=$(grep -n "$MARKER" "$FILE" | grep "PCS_VERSION_MINOR *=" | head -1 || true)
  if [ -n "$LINE" ]; then
    NUM=$(printf '%s' "$LINE" | cut -d: -f1)
    CUR=$(printf '%s' "$LINE" | sed -E 's/.*PCS_VERSION_MINOR *= *([0-9]+).*/\1/')
    case "$CUR" in
      ''|*[!0-9]*) echo "pre-commit: could not read minor — version NOT bumped." >&2 ;;
      *)
        NEXT=$((CUR + 1))
        sed -i.bak "${NUM}s/PCS_VERSION_MINOR *= *[0-9]*/PCS_VERSION_MINOR = ${NEXT}/" "$FILE"
        rm -f "$FILE.bak"
        git add "$FILE"
        MAJOR=$(grep -E "PCS_VERSION_MAJOR *= *[0-9]+" "$FILE" | head -1 | sed -E 's/.*= *([0-9]+).*/\1/')
        echo "pre-commit: version bumped to V${MAJOR}.${NEXT}"
        ;;
    esac
  else
    echo "pre-commit: $MARKER line not found — version NOT bumped." >&2
  fi
fi

# ── 2 · manifest ──────────────────────────────────────────────────────────
# Written on EVERY commit, not just ones touching the builder: a commit that
# changes only the engine still changes what has to be deployed.
VER=""
if [ -f "$FILE" ]; then
  MA=$(grep -E "PCS_VERSION_MAJOR *= *[0-9]+" "$FILE" | head -1 | sed -E 's/.*= *([0-9]+).*/\1/')
  MI=$(grep "$MARKER" "$FILE" | grep "PCS_VERSION_MINOR *=" | head -1 | sed -E 's/.*= *([0-9]+).*/\1/')
  VER="V${MA}.${MI}"
fi

{
  printf '{\n'
  printf '  "version": "%s",\n' "$VER"
  printf '  "generatedAt": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  "commit": "%s",\n' "$(git rev-parse --short HEAD 2>/dev/null || echo 'initial')"
  printf '  "files": {\n'
  FIRST=1
  for f in $DEPLOYABLES; do
    [ -f "$SRC/$f" ] || { echo "pre-commit: WARNING $f missing — not in manifest." >&2; continue; }
    [ $FIRST -eq 1 ] || printf ',\n'
    FIRST=0
    printf '    "%s": "%s"' "$f" "$(sha_of "$SRC/$f")"
  done
  printf '\n  }\n}\n'
} > "$MANIFEST"

git add "$MANIFEST"
echo "pre-commit: build-manifest.json written ($VER)"
