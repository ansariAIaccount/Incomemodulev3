# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Investran credentials.
# .env is gitignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────────

# Proxy listen port (V3 will call http://localhost:<this>/api/diu/...)
PROXY_PORT=4318

# Investran environment base URL — NO trailing slash, NO /DataImport suffix
# (the DIU path below is appended automatically).
#   UAT:  https://investran-uat-us-live.fisglobal.com/api
INVESTRAN_BASE_URL=https://investran-uat-us-live.fisglobal.com/api

# DIU route prefix appended to the base URL. Investran serves this as
# /api/DataImport/ — the capital D and I matter on case-sensitive gateways.
# Add a version segment here if your tenant needs one (e.g. /DataImport/v1).
INVESTRAN_DIU_PATH=/DataImport

# ══════════════════════════════════════════════════════════════════
# AUTH — pick ONE of the two modes below.
# ══════════════════════════════════════════════════════════════════

# ── Mode A · Static bearer token (most FIS tenants) ───────────────
# FIS issues a long-lived RS256 JWT with aud=investran-web-api and
# iss=https://login<N>.fisglobal.com/idp/Investran<ENV>. Paste it here
# and the proxy skips OAuth entirely.
#
# The proxy reads Database / Server / accessToken straight out of the
# token payload, so you normally only need this one value. Override the
# three below only if your tenant needs different values.
#
# ⚠ These tokens expire (typically 30 days). /healthz reports days left
#   and the DIU chip in the app warns before it lapses.
INVESTRAN_BEARER_TOKEN=

# Optional overrides — leave blank to read them from the JWT payload
INVESTRAN_DATABASE=
INVESTRAN_SERVER=
INVESTRAN_ACCESS_TOKEN=

# Header names carrying the tenant routing values. Defaults suit most
# builds; change only if your Investran instance expects different ones.
INVESTRAN_HEADER_DATABASE=X-Investran-Database
INVESTRAN_HEADER_SERVER=X-Investran-Server
INVESTRAN_HEADER_ACCESSTOKEN=X-Investran-AccessToken

# ── Mode B · OAuth2 client-credentials ────────────────────────────
# Only for tenants that expose a token endpoint. Ignored when
# INVESTRAN_BEARER_TOKEN is set.
INVESTRAN_CLIENT_ID=
INVESTRAN_CLIENT_SECRET=
INVESTRAN_OAUTH_SCOPE=dataimport.write
# Optional override of the token endpoint (defaults to <base>/oauth/token)
INVESTRAN_TOKEN_URL=

# Comma-separated list of origins allowed to call this proxy.
# Use "*" only in dev; tighten in prod.
ALLOWED_ORIGINS=http://localhost:8000,file://

# Default DIU template name used when V3 doesn't supply one
DEFAULT_TEMPLATE=IFRS_Loan_GL_DIU_Template

# Verbose request logging (1 = on)
LOG_VERBOSE=1
